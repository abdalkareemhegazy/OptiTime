@startuml fig-version-states
skinparam defaultFontName Tahoma
skinparam shadowing false
skinparam roundcorner 14
skinparam dpi 150
skinparam defaultTextAlignment center
skinparam ArrowColor #455A64
skinparam ArrowFontSize 12
skinparam state {
  BackgroundColor #E3F2FD
  BorderColor #546E7A
  FontSize 14
  StartColor #37474F
  EndColor #37474F
}
hide empty description
left to right direction

state "مسودة\ndraft" as D
state "بانتظار الاعتماد\nsubmitted" as S #FFF59D
state "مرجعة بملاحظات\nreturned" as R #FFCDD2
state "معتمدة\napproved" as A #C8E6C9
state "منشورة\npublished" as P #A5D6A7
state "مؤرشفة\narchived" as X #CFD8DC

[*] --> D : إنشاء أو نسخ\nأو إضافة جدول مولَّد
D --> S : إرسال بعد اجتياز\nقائمة التحقق\n(المنسق)
S --> D : سحب قبل\nبدء المراجعة\n(المنسق)
S --> R : إرجاع بملاحظات\nوسبب إلزامي\n(الشؤون الأكاديمية)
R --> S : إعادة الإرسال\nبعد المعالجة\n(المنسق)
S --> A : اعتماد\n(الشؤون الأكاديمية)
A --> P : نشر\n(الشؤون الأكاديمية)
P --> X : حلّت محلها نسخة\nأحدث لنطاقها
@enduml
