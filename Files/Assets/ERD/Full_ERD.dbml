// OptiTime: مخطط الكيانات والعلاقات للنظام كاملاً (DBML، يُلصق في dbdiagram.io)
// 181 جدولاً في 25 مجموعة، و263 علاقة، والمخطط مقسوم إلى 8 أقسام في مجلد Parts.
// يضم كل جدول تحتاجه حالة من حالات الاستخدام الـ 113 أو متطلب من متطلبات وثيقة المتطلبات الـ 256،
// ولا يضم جدولاً لا يحتاجه أي منهما. ولكل جدول أعمدته الحقيقية كما في قاعدة البيانات أو تصميمها.
// لا تظهر أعمدة التتبّع (created_at و updated_at و deleted_at و created_by و updated_by) لأنها في كل جدول،
// ولا الأعمدة المنسوخة من جدول آخر لتسريع البحث، ولا أعمدة التشغيل الداخلي (مثل منع تكرار الإشعار).
// ولا يضم جدولاً مشتقاً يُحسب من جداول أخرى، ولا جدولين يحفظان الشيء نفسه.
// تُرسم العلاقة حين ينتمي السجل إلى الجدول الآخر أو يخصّه أو يُسند إليه.
// ولا تُرسم لأعمدة من نفّذ الإجراء (…_by)، فسجل التدقيق يحفظ ذلك، ولا لعلاقة تُعرف من علاقة مرسومة أخرى.

Project OptiTime {
  database_type: 'MySQL'
  Note: 'نظام جدولة الموارد التعليمية وإدارتها المدعوم بالذكاء الاصطناعي'
}

// ==================== 01. الهوية والصلاحيات ====================

Table users {
  id uuid [pk]
  role_id uuid [ref: > roles.id]
  department_id uuid [ref: > departments.id]
  full_name varchar(150)
  email varchar(190) [unique]
  avatar_url text
  password_hash varchar(255)
  password_updated_at timestamp
  is_active boolean
  last_login_at timestamp
  is_protected boolean
  name_en varchar(150)
  phone varchar(20)
  username varchar(50) [unique]
  user_type varchar(20)
  status varchar(30)
  locale varchar(5)
  theme varchar(10)
  must_change_password boolean
  two_factor_secret text
  two_factor_recovery_codes text
  two_factor_confirmed_at timestamp
  email_verified_at timestamp
  last_login_ip varchar(45)
  failed_login_attempts smallint
  locked_until timestamp
  administrative_unit_id uuid [ref: > administrative_units.id]
  employee_number varchar(20) [unique]
  Note: 'حسابات كل من يدخل النظام'
}

Table roles {
  id uuid [pk]
  code varchar(50) [unique]
  name_ar varchar(120)
  name_en varchar(120)
  sidebar_color varchar(20)
  description text
  is_system boolean
  is_active boolean
  scope_level varchar(20)
  requires_two_factor boolean
  Note: 'الأدوار وصلاحياتها'
}

Table permissions {
  id uuid [pk]
  code varchar(100) [unique]
  module varchar(80)
  action varchar(80)
  description text
  is_system boolean
  name_ar varchar(150)
  name_en varchar(150)
  is_sensitive boolean
  Note: 'الصلاحيات الدقيقة لكل وحدة'
}

Table role_permissions {
  role_id uuid [ref: > roles.id]
  permission_id uuid [ref: > permissions.id]
  granted_at timestamp
  granted_by uuid
  indexes {
    (role_id, permission_id) [pk]
  }
  Note: 'صلاحيات كل دور'
}

Table user_roles {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  role_id uuid [ref: > roles.id]
  scope_type varchar(20)
  scope_id uuid
  starts_at timestamp
  ends_at timestamp
  assigned_by uuid
  Note: 'أدوار الحساب ونطاق كل دور ومدته'
}

Table personal_access_tokens {
  id bigint [pk]
  tokenable_id uuid [ref: > users.id]
  name varchar(255)
  ip_address varchar(45)
  user_agent varchar(255)
  last_used_at timestamp
  expires_at timestamp
  impersonator_id uuid
  Note: 'جلسات الدخول لكل جهاز، ومنها الدخول باسم مستخدم آخر'
}

Table password_histories {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  password_hash varchar(255)
  Note: 'كلمات المرور السابقة لمنع تكرارها'
}

Table login_attempts {
  id uuid [pk]
  identifier varchar(191)
  user_id uuid
  ip varchar(45)
  user_agent varchar(255)
  succeeded boolean
  failure_reason varchar(40)
  Note: 'سجل محاولات الدخول'
}

Table auth_otps {
  id uuid [pk]
  email varchar(190)
  purpose varchar(40)
  otp_hash varchar(255)
  payload_json json
  attempts tinyint
  expires_at timestamp
  Note: 'رموز التحقق المرسلة إلى البريد'
}

TableGroup "الهوية والصلاحيات" [color: #1E3A8A] {
  users
  roles
  permissions
  role_permissions
  user_roles
  personal_access_tokens
  password_histories
  login_attempts
  auth_otps
}

// ==================== 02. الإشعارات والإعلانات ====================

Table notifications {
  id varchar(80) [pk]
  user_id uuid [ref: > users.id]
  title varchar(190)
  message text
  type varchar(50)
  priority varchar(20)
  is_read boolean
  payload json
  read_at timestamp
  Note: 'إشعارات المستخدمين'
}

Table user_settings {
  user_id uuid [pk, ref: - users.id]
  email_schedule_updates boolean
  email_reminders boolean
  push_announcements boolean
  push_system_alerts boolean
  weekly_digest boolean
  Note: 'تفضيلات الإشعارات لكل مستخدم'
}

Table user_device_tokens {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  fcm_token text
  device_label varchar(80)
  platform varchar(30)
  last_seen_at timestamp
  Note: 'أجهزة المستخدم للإشعارات الفورية'
}

Table notification_templates {
  id uuid [pk]
  key varchar(60)
  channel varchar(15)
  locale varchar(5)
  subject varchar(255)
  body text
  is_active boolean
  Note: 'قوالب رسائل البريد والإشعارات'
}

Table announcements {
  id uuid [pk]
  title_ar varchar(255)
  title_en varchar(255)
  body_ar text
  body_en text
  audience json
  priority varchar(10)
  channels json
  is_pinned boolean
  status varchar(15)
  publish_at timestamp
  expires_at timestamp
  recipients_count int
  author_id uuid
  Note: 'الإعلانات للجامعة أو الكلية أو القسم أو الشعبة'
}

Table announcement_files {
  announcement_id uuid [ref: > announcements.id]
  file_id uuid [ref: > files.id]
  indexes {
    (announcement_id, file_id) [pk]
  }
  Note: 'مرفقات الإعلان'
}

Table announcement_reads {
  announcement_id uuid [ref: > announcements.id]
  user_id uuid [ref: > users.id]
  read_at timestamp
  indexes {
    (announcement_id, user_id) [pk]
  }
  Note: 'من قرأ الإعلان ومتى'
}

TableGroup "الإشعارات والإعلانات" [color: #0284C7] {
  notifications
  user_settings
  user_device_tokens
  notification_templates
  announcements
  announcement_files
  announcement_reads
}

// ==================== 03. إدارة النظام ====================

Table system_settings {
  key varchar(100) [pk]
  group varchar(40)
  value json
  type varchar(20)
  is_public boolean
  Note: 'إعدادات النظام مجمّعة حسب المجال'
}

Table files {
  id uuid [pk]
  disk varchar(20)
  path varchar(500)
  original_name varchar(255)
  extension varchar(10)
  mime_type varchar(120)
  size_bytes bigint
  checksum_sha256 char(64)
  fileable_type varchar(100)
  fileable_id uuid
  collection varchar(50)
  visibility varchar(20)
  scan_status varchar(20)
  uploaded_by uuid
  Note: 'الملفات المرفوعة'
}

Table audit_logs {
  id uuid [pk]
  actor_user_id uuid [ref: > users.id]
  event_type varchar(20)
  module varchar(80)
  action varchar(120)
  description text
  target_table varchar(80)
  target_id uuid
  request_id varchar(120)
  ip_address varchar(45)
  user_agent varchar(255)
  metadata json
  before_data json
  after_data json
  Note: 'سجل التدقيق: من فعل ماذا ومتى، ولذلك لا تُرسم أعمدة من نفّذ الإجراء في الجداول الأخرى'
}

Table status_transitions {
  id uuid [pk]
  subject_type varchar(100)
  subject_id uuid
  from_status varchar(30)
  to_status varchar(30)
  action varchar(40)
  actor_id uuid
  comment text
  meta json
  Note: 'سجل انتقالات الحالة لأي سجل: الفصل ونسخة الجدول والبلاغات والطلبات والحجوزات'
}

Table imports {
  id uuid [pk]
  number varchar(30) [unique]
  type varchar(40)
  file_id uuid [ref: > files.id]
  status varchar(30)
  headers json
  column_mapping json
  options json
  total_rows int
  valid_rows int
  imported_rows int
  updated_rows int
  skipped_rows int
  failed_rows int
  errors json
  context_type varchar(100)
  context_id uuid
  started_at timestamp
  finished_at timestamp
  Note: 'عمليات الاستيراد من ملفات Excel'
}

Table exports {
  id uuid [pk]
  number varchar(30) [unique]
  type varchar(60)
  format varchar(10)
  params json
  status varchar(20)
  file_id uuid [ref: > files.id]
  rows_count int
  error text
  expires_at timestamp
  started_at timestamp
  finished_at timestamp
  Note: 'عمليات التصدير إلى ملفات'
}

Table backups {
  id uuid [pk]
  type varchar(20)
  trigger varchar(20)
  disk varchar(30)
  path varchar(500)
  file_name varchar(255)
  size_bytes bigint
  checksum_sha256 char(64)
  is_encrypted boolean
  status varchar(20)
  initiated_by uuid
  meta json
  started_at timestamp
  finished_at timestamp
  error text
  Note: 'النسخ الاحتياطية'
}

Table restores {
  id uuid [pk]
  backup_id uuid [ref: > backups.id]
  safety_backup_id uuid
  status varchar(20)
  initiated_by uuid
  confirmed_2fa_at timestamp
  started_at timestamp
  finished_at timestamp
  notes text
  error text
  meta json
  Note: 'عمليات الاستعادة من نسخة احتياطية'
}

Table api_keys {
  id uuid [pk]
  name varchar(100)
  key_prefix varchar(12)
  key_hash char(64) [unique]
  scopes json
  allowed_ips json
  last_used_at timestamp
  expires_at timestamp
  revoked_at timestamp
  Note: 'مفاتيح دخول الأنظمة الخارجية'
}

Table integrations {
  key varchar(40) [pk]
  driver varchar(40)
  config_encrypted text
  is_enabled boolean
  last_tested_at timestamp
  last_test_result varchar(20)
  last_test_message text
  Note: 'إعدادات الخدمات المتصلة بالنظام'
}

Table health_check_results {
  id uuid [pk]
  check_name varchar(60)
  status varchar(20)
  message varchar(120)
  meta json
  Note: 'نتائج فحوص صحة النظام'
}

TableGroup "إدارة النظام" [color: #475569] {
  system_settings
  files
  audit_logs
  status_transitions
  imports
  exports
  backups
  restores
  api_keys
  integrations
  health_check_results
}

// ==================== 04. الهيكل التنظيمي ====================

Table campuses {
  id uuid [pk]
  code varchar(10) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  address_ar varchar(255)
  address_en varchar(255)
  is_active boolean
  Note: 'فروع الجامعة'
}

Table buildings {
  id uuid [pk]
  campus_id uuid [ref: > campuses.id]
  code varchar(10) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  floors_count smallint
  latitude decimal(9,6)
  longitude decimal(9,6)
  is_active boolean
  Note: 'مباني كل فرع'
}

Table faculties {
  id uuid [pk]
  code varchar(50) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  graduation_hours int
  studying_level int
  color varchar(20)
  icon_url text
  is_active boolean
  building_id uuid [ref: > buildings.id]
  dean_user_id uuid [ref: > users.id]
  Note: 'الكليات وعمداؤها'
}

Table departments {
  id uuid [pk]
  faculty_id uuid [ref: > faculties.id]
  code varchar(50) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  icon_url text
  is_active boolean
  head_user_id uuid [ref: > users.id]
  Note: 'الأقسام ورؤساؤها'
}

Table programs {
  id uuid [pk]
  department_id uuid [ref: > departments.id]
  code varchar(20) [unique]
  name_ar varchar(200)
  name_en varchar(200)
  degree_level varchar(20)
  total_credit_hours smallint
  duration_semesters tinyint
  max_duration_semesters tinyint
  level_thresholds json
  is_active boolean
  grading_scheme_id uuid [ref: > grading_schemes.id]
  Note: 'البرامج الأكاديمية لكل قسم'
}

Table administrative_units {
  id uuid [pk]
  parent_id uuid [ref: > administrative_units.id]
  code varchar(20) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  manager_user_id uuid [ref: > users.id]
  building_id uuid [ref: > buildings.id]
  email varchar(190)
  phone varchar(30)
  is_active boolean
  Note: 'الوحدات الإدارية كالمالية والمكتبة'
}

TableGroup "الهيكل التنظيمي" [color: #0F766E] {
  campuses
  buildings
  faculties
  departments
  programs
  administrative_units
}

// ==================== 05. التقويم الأكاديمي ====================

Table academic_years {
  id uuid [pk]
  code varchar(9) [unique]
  starts_on date
  ends_on date
  is_current boolean
  Note: 'السنوات الأكاديمية'
}

Table semesters {
  id uuid [pk]
  code varchar(50) [unique]
  start_date date
  end_date date
  is_active boolean
  academic_year_id uuid [ref: > academic_years.id]
  type varchar(10)
  name_ar varchar(150)
  name_en varchar(150)
  classes_start_date date
  classes_end_date date
  weeks_count smallint
  status varchar(20)
  Note: 'الفصول الدراسية ومراحلها'
}

Table semester_windows {
  id uuid [pk]
  semester_id uuid [ref: > semesters.id]
  type varchar(30)
  starts_at datetime
  ends_at datetime
  is_active boolean
  notes text
  Note: 'نوافذ الفصل كالتسجيل والتفرغ ورصد العلامات'
}

Table holidays {
  id uuid [pk]
  name_ar varchar(150)
  name_en varchar(150)
  category varchar(20)
  starts_on date
  ends_on date
  affects_classes boolean
  affects_exams boolean
  affects_staff boolean
  Note: 'العطل وما توقفه'
}

Table registration_priority_groups {
  id uuid [pk]
  semester_id uuid [ref: > semesters.id]
  priority smallint
  name_ar varchar(100)
  name_en varchar(100)
  criteria json
  opens_at datetime
  announced_at timestamp
  Note: 'أدوار التسجيل لمجموعات الطلاب'
}

Table calendar_feeds {
  id uuid [pk]
  user_id uuid [unique, ref: - users.id]
  token_hash varchar(64) [unique]
  token_prefix varchar(8)
  with_lectures boolean
  last_used_at timestamp
  Note: 'روابط الاشتراك بالتقويم'
}

TableGroup "التقويم الأكاديمي" [color: #0369A1] {
  academic_years
  semesters
  semester_windows
  holidays
  registration_priority_groups
  calendar_feeds
}

// ==================== 06. المقررات والخطط الدراسية ====================

Table grading_schemes {
  id uuid [pk]
  name_ar varchar(100)
  name_en varchar(100)
  max_points decimal(3,2)
  pass_mark decimal(5,2)
  is_default boolean
  Note: 'سلالم التقدير'
}

Table grading_scale_items {
  id uuid [pk]
  grading_scheme_id uuid [ref: > grading_schemes.id]
  letter varchar(3)
  min_mark decimal(5,2)
  max_mark decimal(5,2)
  grade_points decimal(3,2)
  description_ar varchar(50)
  description_en varchar(50)
  is_passing boolean
  counts_in_gpa boolean
  counts_as_earned boolean
  is_special boolean
  sort smallint
  Note: 'حروف كل سلّم ونقاطها'
}

Table courses {
  id uuid [pk]
  department_id uuid [ref: > departments.id]
  code varchar(50)
  name_ar varchar(190)
  name_en varchar(190)
  required_hours int
  room_consumed_hours int
  lab_consumed_hours int
  has_lab_component boolean
  credit_hours tinyint
  category varchar(15)
  level tinyint
  description_ar text
  description_en text
  grading_mode varchar(15)
  is_repeatable boolean
  is_active boolean
  Note: 'كتالوج المقررات'
}

Table course_prerequisites {
  id uuid [pk]
  course_id uuid [ref: > courses.id]
  prerequisite_course_id uuid [ref: > courses.id]
  type varchar(15)
  group_no smallint
  min_grade varchar(3)
  Note: 'المتطلبات السابقة والمتزامنة'
}

Table course_equivalencies {
  id uuid [pk]
  course_id uuid [ref: > courses.id]
  equivalent_course_id uuid [ref: > courses.id]
  is_bidirectional boolean
  notes text
  Note: 'المقررات المعادلة'
}

Table course_constraints {
  id uuid [pk]
  course_id uuid [unique, ref: - courses.id]
  min_student_year_level int
  max_student_year_level int
  notes text
  Note: 'السنوات الدراسية المسموح لها بالمقرر'
}

Table course_topics {
  id uuid [pk]
  course_id uuid [ref: > courses.id]
  week_no smallint
  title_ar varchar(255)
  title_en varchar(255)
  description text
  sort smallint
  component varchar(10)
  Note: 'مفردات المقرر الأسبوعية'
}

Table course_assessment_components {
  id uuid [pk]
  course_id uuid [ref: > courses.id]
  name_ar varchar(100)
  name_en varchar(100)
  type varchar(20)
  weight decimal(5,2)
  max_mark decimal(6,2)
  is_final_exam boolean
  sort smallint
  Note: 'قالب مكوّنات علامة المقرر'
}

Table study_plans {
  id uuid [pk]
  program_id uuid [ref: > programs.id]
  code varchar(30) [unique]
  name_ar varchar(200)
  name_en varchar(200)
  effective_from_year smallint
  total_credit_hours smallint
  status varchar(15)
  notes text
  cloned_from_id uuid
  approved_by uuid
  approved_at datetime
  Note: 'الخطط الدراسية لكل برنامج'
}

Table study_plan_groups {
  id uuid [pk]
  study_plan_id uuid [ref: > study_plans.id]
  type varchar(30)
  name_ar varchar(150)
  name_en varchar(150)
  min_credit_hours smallint
  sort smallint
  Note: 'مجموعات متطلبات الخطة'
}

Table study_plan_courses {
  id uuid [pk]
  study_plan_id uuid
  study_plan_group_id uuid [ref: > study_plan_groups.id]
  course_id uuid [ref: > courses.id]
  recommended_level smallint
  recommended_semester smallint
  sort smallint
  Note: 'مقررات كل مجموعة في الخطة'
}

TableGroup "المقررات والخطط الدراسية" [color: #4338CA] {
  grading_schemes
  grading_scale_items
  courses
  course_prerequisites
  course_equivalencies
  course_constraints
  course_topics
  course_assessment_components
  study_plans
  study_plan_groups
  study_plan_courses
}

// ==================== 07. القاعات والموارد ====================

Table rooms {
  id uuid [pk]
  name_ar varchar(190)
  name_en varchar(190)
  type varchar(30)
  capacity int
  location_ar varchar(190)
  location_en varchar(190)
  status varchar(30)
  notes_ar text
  notes_en text
  faculty_id uuid [ref: > faculties.id]
  building_id uuid [ref: > buildings.id]
  code varchar(20) [unique]
  department_id uuid [ref: > departments.id]
  floor smallint
  exam_capacity smallint
  seat_rows smallint
  seat_columns smallint
  is_accessible boolean
  is_schedulable boolean
  is_bookable boolean
  Note: 'القاعات والمختبرات والمدرجات'
}

Table features {
  id uuid [pk]
  key varchar(40) [unique]
  name_ar varchar(100)
  name_en varchar(100)
  icon varchar(40)
  sort smallint
  is_active boolean
  Note: 'ميزات القاعات'
}

Table room_features {
  id uuid [pk]
  room_id uuid [ref: > rooms.id]
  feature_id uuid [ref: > features.id]
  quantity smallint
  Note: 'ميزات كل قاعة وعددها'
}

Table equipment {
  id uuid [pk]
  asset_tag varchar(255) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  category varchar(40)
  faculty_id uuid [ref: > faculties.id]
  room_id uuid [ref: > rooms.id]
  is_portable boolean
  status varchar(20)
  serial_number varchar(80)
  purchased_on date
  warranty_until date
  notes text
  Note: 'الأجهزة والتجهيزات برقم أصل'
}

Table maintenance_logs {
  id uuid [pk]
  reference varchar(20) [unique]
  room_id uuid [ref: > rooms.id]
  equipment_id uuid [ref: > equipment.id]
  target_type varchar(10)
  target_label varchar(200)
  category varchar(20)
  title varchar(200)
  description text
  priority varchar(10)
  status varchar(20)
  blocks_usage boolean
  previous_status varchar(30)
  starts_at datetime
  expected_until datetime
  assignee varchar(150)
  reported_by uuid
  taken_at datetime
  taken_by uuid
  resolved_at datetime
  resolved_by uuid
  resolution_notes text
  schedule_session_id uuid
  session_date date
  cannot_teach boolean
  lecture_decision varchar(10)
  lecture_room_id uuid
  decision_note text
  decided_at datetime
  decided_by uuid
  class_session_id uuid [ref: > class_sessions.id]
  Note: 'بلاغات الأعطال وصيانتها'
}

Table resource_requests {
  id uuid [pk]
  reference varchar(20) [unique]
  requester_id uuid
  schedule_session_id uuid [ref: > schedule_sessions.id]
  lecture_label varchar(200)
  request_type varchar(12)
  first_date date
  last_date date
  room_family varchar(12)
  room_type varchar(30)
  features json
  min_seats smallint
  equipment_category varchar(30)
  equipment_name_ar varchar(150)
  equipment_name_en varchar(150)
  quantity smallint
  item varchar(200)
  reason text
  status varchar(12)
  room_id uuid [ref: > rooms.id]
  reviewed_by uuid
  reviewed_at datetime
  review_notes text
  closed_at datetime
  Note: 'طلبات المدرّسين لقاعات أو تجهيزات'
}

Table resource_request_units {
  resource_request_id uuid [ref: > resource_requests.id]
  equipment_id uuid [ref: > equipment.id]
  indexes {
    (resource_request_id, equipment_id) [pk]
  }
  Note: 'الأجهزة المخصصة لكل طلب'
}

Table room_reservations {
  id uuid [pk]
  reference varchar(20) [unique]
  room_id uuid [ref: > rooms.id]
  room_label varchar(200)
  user_id uuid [ref: > users.id]
  purpose varchar(12)
  title varchar(200)
  notes text
  starts_at datetime
  ends_at datetime
  attendees smallint
  status varchar(12)
  check_in_required boolean
  checked_in_at datetime
  series_id uuid
  reviewed_by uuid
  reviewed_at datetime
  review_notes text
  closed_at datetime
  booked_by uuid
  Note: 'حجوزات القاعات'
}

TableGroup "القاعات والموارد" [color: #B45309] {
  rooms
  features
  room_features
  equipment
  maintenance_logs
  resource_requests
  resource_request_units
  room_reservations
}

// ==================== 08. أعضاء هيئة التدريس ====================

Table instructors {
  id uuid [pk]
  user_id uuid [unique, ref: - users.id]
  specialization_id uuid [ref: > specializations.id]
  min_work_hours_per_week int
  max_work_hours_per_week int
  academic_rank varchar(30)
  highest_degree varchar(20)
  specialization_ar varchar(200)
  specialization_en varchar(200)
  is_part_time boolean
  can_proctor boolean
  office_location varchar(150)
  office_hours json
  Note: 'الملف التدريسي لعضو هيئة التدريس'
}

Table specializations {
  id uuid [pk]
  code varchar(50) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  is_active boolean
  Note: 'قائمة التخصصات'
}

Table instructor_qualified_courses {
  id uuid [pk]
  instructor_id uuid [ref: > instructors.id]
  course_id uuid [ref: > courses.id]
  components json
  preference tinyint
  source varchar(20)
  set_by uuid
  Note: 'المقررات التي يؤهَّل المدرّس لتدريسها'
}

Table instructor_availability_profiles {
  id uuid [pk]
  instructor_id uuid [ref: > instructors.id]
  notes text
  semester_id uuid [ref: > semesters.id]
  status varchar(15)
  submitted_at timestamp
  submitted_by uuid
  Note: 'أسبوع تفرّغ المدرّس في كل فصل'
}

Table instructor_availability_cells {
  id uuid [pk]
  availability_profile_id uuid [ref: > instructor_availability_profiles.id]
  day_value varchar(10)
  start_time time
  end_time time
  status varchar(20)
  reason_code varchar(30)
  reason varchar(150)
  Note: 'الأوقات المفضّلة والمتاحة والمغلقة في الأسبوع'
}

Table instructor_availability_reminders {
  id uuid [pk]
  semester_id uuid
  instructor_id uuid [ref: > instructors.id]
  sent_by uuid
  automatic boolean
  Note: 'تذكيرات تسليم التفرّغ'
}

TableGroup "أعضاء هيئة التدريس" [color: #7C3AED] {
  instructors
  specializations
  instructor_qualified_courses
  instructor_availability_profiles
  instructor_availability_cells
  instructor_availability_reminders
}

// ==================== 09. الجدول الدراسي ====================

Table course_offerings {
  id uuid [pk]
  course_id uuid [ref: > courses.id]
  semester_id uuid [ref: > semesters.id]
  is_active boolean
  status varchar(15)
  expected_students int
  forecast_demand int
  forecast_lower int
  forecast_upper int
  prediction_model_id uuid [ref: > prediction_models.id]
  planned_theory_sections smallint
  planned_lab_sections smallint
  source varchar(15)
  demand json
  adjusted boolean
  notes text
  estimated_at timestamp
  confirmed_at timestamp
  confirmed_by uuid
  Note: 'المقررات المطروحة في الفصل وتقدير طلبها بالمعادلة وبنموذج التنبؤ'
}

Table course_sections {
  id uuid [pk]
  course_id uuid
  section_name varchar(120)
  section_type varchar(20)
  capacity int
  meetings_per_week tinyint
  meeting_minutes smallint
  semester_id uuid
  course_offering_id uuid [ref: > course_offerings.id]
  component varchar(10)
  section_number varchar(5)
  parent_section_id uuid [ref: > course_sections.id]
  delivery_mode varchar(15)
  language varchar(5)
  restrictions json
  status varchar(15)
  cancelled_reason text
  notes text
  Note: 'شعب كل مقرر مطروح'
}

Table course_section_instructors {
  id uuid [pk]
  section_id uuid [ref: > course_sections.id]
  instructor_id uuid [ref: > instructors.id]
  role varchar(15)
  load_share decimal(4,2)
  Note: 'مدرّسو كل شعبة وأحمالهم'
}

Table semester_schedule_plans {
  id uuid [pk]
  semester_id uuid [ref: > semesters.id]
  status varchar(30)
  selected_algorithm varchar(30)
  generated_at timestamp
  notes text
  faculty_id uuid [ref: > faculties.id]
  name varchar(150)
  version_no smallint
  source varchar(15)
  cloned_from_id uuid
  quality_score decimal(5,2)
  hard_conflicts_count int
  soft_conflicts_count int
  lock_version int
  checklist json
  checked_at timestamp
  submitted_by uuid
  submitted_at timestamp
  reviewed_by uuid
  reviewed_at timestamp
  approved_by uuid
  approved_at timestamp
  published_by uuid
  published_at timestamp
  archived_by uuid
  archived_at timestamp
  conflicts_checked_at timestamp
  quality_breakdown json
  Note: 'نسخ الجدول الدراسي ومسار اعتمادها'
}

Table schedule_sessions {
  id uuid [pk]
  room_id uuid [ref: > rooms.id]
  schedule_plan_id uuid [ref: > semester_schedule_plans.id]
  section_instructor_id uuid [ref: > course_section_instructors.id]
  course_offering_id uuid
  day_value varchar(10)
  start_time time
  end_time time
  conflict_state varchar(20)
  conflict_reasons text
  grades_entry_status varchar(20)
  grades_marked_done_at timestamp
  week_pattern varchar(20)
  is_locked boolean
  locked_by uuid
  locked_at timestamp
  Note: 'محاضرات الجدول الأسبوعي'
}

Table schedule_comments {
  id uuid [pk]
  schedule_plan_id uuid [ref: > semester_schedule_plans.id]
  schedule_session_id uuid [ref: > schedule_sessions.id]
  author_id uuid
  body text
  is_resolved boolean
  resolved_by uuid
  resolved_at timestamp
  Note: 'ملاحظات المراجعة على النسخة'
}

Table schedule_conflicts {
  id uuid [pk]
  schedule_plan_id uuid [ref: > semester_schedule_plans.id]
  conflict_key varchar(32)
  type varchar(40)
  severity varchar(5)
  rule varchar(120)
  session_ids json
  details json
  status varchar(10)
  note text
  ignored_by uuid
  ignored_at timestamp
  resolved_at timestamp
  Note: 'تعارضات النسخة'
}

Table schedule_generation_jobs {
  id uuid [pk]
  requested_by_user_id uuid
  status varchar(20)
  algorithm varchar(20)
  semester_id uuid [ref: > semesters.id]
  request_payload json
  result_payload json
  error_message text
  progress tinyint
  queued_at timestamp
  started_at timestamp
  finished_at timestamp
  faculty_id uuid
  department_id uuid
  mode varchar(20)
  relaxed_rule varchar(60)
  phase varchar(20)
  best_objective decimal(14,4)
  objective_value decimal(14,4)
  hard_violations int
  placed_count int
  unplaced_count int
  bent_count int
  stats json
  Note: 'عمليات توليد الجدول بمحرك الجدولة'
}

TableGroup "الجدول الدراسي" [color: #2563EB] {
  course_offerings
  course_sections
  course_section_instructors
  semester_schedule_plans
  schedule_sessions
  schedule_comments
  schedule_conflicts
  schedule_generation_jobs
}

// ==================== 10. إعدادات الجدولة ====================

Table schedule_settings {
  id uuid [pk]
  day_start time
  day_end time
  gap_minutes int
  max_daily_lectures int
  capacity_threshold int
  step_minutes smallint
  quality_minimum tinyint
  Note: 'إعدادات الأسبوع الدراسي'
}

Table schedule_setting_study_days {
  id uuid [pk]
  schedule_setting_id uuid [ref: > schedule_settings.id]
  day_value varchar(10)
  enabled boolean
  Note: 'أيام الدراسة'
}

Table schedule_setting_break_times {
  id uuid [pk]
  schedule_setting_id uuid [ref: > schedule_settings.id]
  break_key varchar(100)
  start_time time
  end_time time
  enabled boolean
  Note: 'الاستراحات'
}

Table schedule_setting_constraints {
  id uuid [pk]
  schedule_setting_id uuid [ref: > schedule_settings.id]
  category varchar(30)
  constraint_key varchar(100)
  enabled boolean
  weight decimal(5,2)
  Note: 'قواعد الجدولة الصارمة والمرنة وقواعد القاعات وأوزانها'
}

Table schedule_setting_load_ranges {
  id uuid [pk]
  schedule_setting_id uuid [ref: > schedule_settings.id]
  load_key varchar(100)
  min_value int
  max_value int
  Note: 'حدود الأحمال'
}

Table scheduling_constraints {
  id uuid [pk]
  scope_type varchar(20)
  scope_id uuid
  rule_key varchar(60)
  value json
  is_hard boolean
  weight smallint
  is_active boolean
  Note: 'قيود خاصة بكلية أو قسم أو مدرّس أو قاعة أو مقرر'
}

Table time_slots {
  id uuid [pk]
  day_value varchar(10)
  starts_at time
  ends_at time
  kind varchar(20)
  is_active boolean
  sort smallint
  Note: 'الفترات الزمنية للأسبوع'
}

TableGroup "إعدادات الجدولة" [color: #64748B] {
  schedule_settings
  schedule_setting_study_days
  schedule_setting_break_times
  schedule_setting_constraints
  schedule_setting_load_ranges
  scheduling_constraints
  time_slots
}

// ==================== 11. الجلسات خلال الفصل ====================

Table class_sessions {
  id uuid [pk]
  semester_id uuid
  schedule_session_id uuid [ref: > schedule_sessions.id]
  section_id uuid [ref: > course_sections.id]
  instructor_id uuid [ref: > instructors.id]
  room_id uuid [ref: > rooms.id]
  planned_room_id uuid
  date date
  start_time time
  end_time time
  week_no smallint
  sitting_no smallint
  kind varchar(10)
  status varchar(12)
  change_source varchar(20)
  change_ref uuid
  original_session_id uuid
  topic varchar(255)
  planned_instructor_id uuid
  Note: 'جلسات المحاضرات الفعلية بتواريخها'
}

Table session_changes {
  id uuid [pk]
  class_session_id uuid [ref: > class_sessions.id]
  type varchar(20)
  source varchar(20)
  source_id uuid
  old_values json
  new_values json
  reason text
  decided_at timestamp
  voided_at timestamp
  voided_by uuid
  Note: 'سجل تغييرات الجلسات'
}

Table lecture_requests {
  id uuid [pk]
  schedule_session_id uuid
  instructor_id uuid
  request_type varchar(20)
  requested_date date
  note text
  status varchar(20)
  review_note text
  reviewed_at timestamp
  requested_start time
  requested_end time
  requested_room_id uuid
  reason_code varchar(40)
  class_session_id uuid [ref: > class_sessions.id]
  Note: 'طلبات الاعتذار عن محاضرة أو تعويضها'
}

Table substitutions {
  id uuid [pk]
  class_session_id uuid [ref: > class_sessions.id]
  original_instructor_id uuid
  substitute_instructor_id uuid [ref: > instructors.id]
  leave_request_id uuid [ref: > leave_requests.id]
  reason text
  status varchar(15)
  proposed_at timestamp
  proposed_by uuid
  confirmed_at timestamp
  confirmed_by uuid
  cancelled_at timestamp
  cancelled_by uuid
  cancel_reason varchar(20)
  cancel_note text
  lecture_request_id uuid [ref: > lecture_requests.id]
  Note: 'المدرّسون البدلاء للجلسات'
}

TableGroup "الجلسات خلال الفصل" [color: #0891B2] {
  class_sessions
  session_changes
  lecture_requests
  substitutions
}

// ==================== 12. سجلات الطلاب ====================

Table students {
  user_id uuid [pk, ref: - users.id]
  university_number varchar(40) [unique]
  completed_hours int
  year_level int
  study_status varchar(30)
  program_id uuid [ref: > programs.id]
  advisor_id uuid [ref: > instructors.id]
  gender varchar(6)
  date_of_birth date
  place_of_birth varchar(120)
  nationality char(2)
  residency varchar(15)
  id_document_type varchar(15)
  id_document_number text
  id_document_hash char(64) [unique]
  address_country char(2)
  address_city varchar(80)
  address_line varchar(190)
  guardian_name varchar(150)
  guardian_relation varchar(15)
  guardian_phone varchar(20)
  certificate_type varchar(30)
  certificate_year smallint
  certificate_score decimal(8,2)
  certificate_score_max decimal(8,2)
  certificate_country char(2)
  certificate_institution varchar(150)
  Note: 'ملف الطالب وبرنامجه ومرشده الأكاديمي'
}

Table student_semester_records {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  semester_id uuid [ref: > semesters.id]
  registered_hours smallint
  attempted_hours smallint
  earned_hours smallint
  gpa_hours smallint
  quality_points decimal(8,2)
  semester_gpa decimal(5,4)
  cumulative_gpa decimal(5,4)
  academic_standing varchar(20)
  level_at_end smallint
  is_final boolean
  computed_at timestamp
  Note: 'سجل الطالب في كل فصل: ساعاته ومعدله ووضعه الأكاديمي'
}

Table graduations {
  id uuid [pk]
  student_id uuid [unique, ref: - students.user_id]
  semester_id uuid [ref: > semesters.id]
  final_gpa decimal(5,4)
  total_earned_hours smallint
  classification varchar(20)
  honors boolean
  certificate_number varchar(30) [unique]
  verification_code char(12) [unique]
  approved_by uuid
  graduated_on date
  Note: 'تخرج الطالب وتقدير التخرج ومرتبة الشرف'
}

Table registration_holds {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  type varchar(20)
  reason_ar text
  reason_en text
  blocks json
  source_type varchar(100)
  source_id uuid
  is_automatic boolean
  placed_by uuid
  placed_at timestamp
  released_by uuid
  released_at timestamp
  release_reason text
  Note: 'العوائق المالية والأكاديمية وغيرها، وما يمنعه كل عائق'
}

TableGroup "سجلات الطلاب" [color: #15803D] {
  students
  student_semester_records
  graduations
  registration_holds
}

// ==================== 13. تسجيل المقررات ====================

Table carts {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  semester_id uuid
  status varchar(15)
  confirmation_number varchar(20) [unique]
  idempotency_key uuid [unique]
  invoice_id uuid [ref: > invoices.id]
  total_hours smallint
  confirmed_at timestamp
  last_validated_at timestamp
  expires_at timestamp
  Note: 'سلة تسجيل الطالب في الفصل، وتأكيدها برقم تأكيد واحد'
}

Table cart_items {
  id uuid [pk]
  cart_id uuid [ref: > carts.id]
  section_id uuid [ref: > course_sections.id]
  component varchar(10)
  action varchar(10)
  replaces_enrollment_section_id uuid
  held_until timestamp
  validation_status varchar(10)
  validation_messages json
  Note: 'الشعب المختارة في السلة مع حجز مؤقت لمقاعدها'
}

Table enrollments {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  course_offering_id uuid [ref: > course_offerings.id]
  cart_id uuid [ref: > carts.id]
  status varchar(15)
  source varchar(20)
  is_repeat boolean
  repeats_enrollment_id uuid
  credit_hours smallint
  counts_in_gpa boolean
  enrolled_at timestamp
  dropped_at timestamp
  withdrawn_at timestamp
  status_reason text
  Note: 'تسجيل الطالب في مقرر مطروح'
}

Table enrollment_sections {
  id uuid [pk]
  enrollment_id uuid [ref: > enrollments.id]
  section_id uuid [ref: > course_sections.id]
  component varchar(10)
  status varchar(15)
  added_at timestamp
  released_at timestamp
  Note: 'شعب التسجيل النظرية والعملية'
}

Table waitlist_entries {
  id uuid [pk]
  section_id uuid [ref: > course_sections.id]
  student_id uuid [ref: > students.user_id]
  priority smallint
  joined_at timestamp
  status varchar(15)
  offered_at timestamp
  offer_expires_at timestamp
  skip_count smallint
  last_skip_reason varchar(40)
  resolved_at timestamp
  Note: 'قوائم انتظار الشعب الممتلئة'
}

Table enrollment_overrides {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  semester_id uuid
  course_offering_id uuid [ref: > course_offerings.id]
  section_id uuid [ref: > course_sections.id]
  service_request_id uuid [ref: > service_requests.id]
  type varchar(25)
  reason text
  granted_by uuid
  expires_at timestamp
  used_at timestamp
  revoked_at timestamp
  Note: 'استثناءات التسجيل الموثقة لمقرر أو شعبة أو فصل'
}

TableGroup "تسجيل المقررات" [color: #16A34A] {
  carts
  cart_items
  enrollments
  enrollment_sections
  waitlist_entries
  enrollment_overrides
}

// ==================== 14. الإرشاد الأكاديمي ====================

Table advising_clearances {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  semester_id uuid [ref: > semesters.id]
  advisor_id uuid
  status varchar(15)
  planned_hours smallint
  planned_courses json
  student_notes text
  advisor_notes text
