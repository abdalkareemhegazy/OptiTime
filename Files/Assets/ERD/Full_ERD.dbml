}

// ==================== 15. الحضور والغياب ====================

Table attendance_records {
  id uuid [pk]
  class_session_id uuid [ref: > class_sessions.id]
  enrollment_id uuid [ref: > enrollments.id]
  status varchar(10)
  minutes_late smallint
  method varchar(10)
  marked_by uuid
  marked_at timestamp
  note varchar(255)
  Note: 'حضور كل طالب في كل جلسة'
}

Table attendance_qr_tokens {
  id uuid [pk]
  class_session_id uuid [ref: > class_sessions.id]
  secret char(32)
  started_by uuid
  started_at timestamp
  stopped_at timestamp
  Note: 'رمز QR المتغير لتسجيل حضور الجلسة'
}

Table attendance_warnings {
  id uuid [pk]
  enrollment_id uuid [ref: > enrollments.id]
  level varchar(15)
  absence_percent decimal(5,2)
  status varchar(15)
  approved_by uuid
  approved_at timestamp
