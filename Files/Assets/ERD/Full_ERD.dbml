// ==================== 16. التعلّم الإلكتروني ====================

Table course_materials {
  id uuid [pk]
  section_id uuid [ref: > course_sections.id]
  course_topic_id uuid [ref: > course_topics.id]
  file_id uuid [ref: > files.id]
  title varchar(255)
  description text
  type varchar(10)
  url varchar(1000)
  week_no smallint
  is_published boolean
  published_at timestamp
  downloads_count int
  uploaded_by uuid
  Note: 'محتوى المادة وملفاتها لكل شعبة'
}

Table section_topic_progress {
  id uuid [pk]
  section_id uuid [ref: > course_sections.id]
  course_topic_id uuid [ref: > course_topics.id]
  class_session_id uuid
  status varchar(10)
  covered_on date
  notes text
  Note: 'تقدّم الشعبة في مفردات المقرر'
}

Table question_banks {
  id uuid [pk]
  course_id uuid [ref: > courses.id]
  owner_id uuid
  name varchar(150)
  is_shared boolean
  Note: 'بنوك الأسئلة لكل مقرر'
}

Table questions {
  id uuid [pk]
  question_bank_id uuid [ref: > question_banks.id]
  type varchar(20)
  body text
  options json
  explanation text
  difficulty varchar(10)
  default_points decimal(6,2)
  accepted_answers json
  tags json
  version int
  previous_version_id uuid
  Note: 'أسئلة بنك الأسئلة وخياراتها'
}

Table quizzes {
  id uuid [pk]
  section_id uuid [ref: > course_sections.id]
  assessment_component_id uuid [ref: > assessment_components.id]
  title varchar(255)
  instructions text
  starts_at timestamp
  ends_at timestamp
  duration_minutes smallint
  max_attempts smallint
  grading_method varchar(10)
  shuffle_questions boolean
  shuffle_options boolean
  questions_per_attempt smallint
  show_results varchar(15)
  show_correct_answers boolean
  total_points decimal(7,2)
  passing_points decimal(7,2)
  status varchar(15)
  results_released_at timestamp
  Note: 'الاختبارات القصيرة لكل شعبة'
}

Table quiz_questions {
  quiz_id uuid [ref: > quizzes.id]
  question_id uuid [ref: > questions.id]
  points decimal(6,2)
  sort smallint
  indexes {
    (quiz_id, question_id) [pk]
  }
  Note: 'أسئلة كل اختبار ودرجاتها'
}

Table quiz_accommodations {
  id uuid [pk]
  quiz_id uuid [ref: > quizzes.id]
  student_id uuid [ref: > students.user_id]
  extra_minutes smallint
  extra_attempts smallint
  reason varchar(255)
  Note: 'تسهيلات خاصة لطالب في اختبار'
}

Table quiz_attempts {
  id uuid [pk]
  quiz_id uuid [ref: > quizzes.id]
  student_id uuid [ref: > students.user_id]
  attempt_no smallint
  status varchar(15)
  started_at timestamp
  expires_at timestamp
  submitted_at timestamp
  questions_snapshot json
  score decimal(7,2)
  max_score decimal(7,2)
  needs_manual_grading boolean
  ip varchar(45)
  user_agent text
  Note: 'محاولات الطلاب في الاختبارات'
}

Table quiz_answers {
  id uuid [pk]
  quiz_attempt_id uuid [ref: > quiz_attempts.id]
  question_id uuid [ref: > questions.id]
  selected_option_ids json
  text_answer text
  numeric_answer decimal(14,4)
  is_flagged boolean
  is_correct boolean
  points_awarded decimal(6,2)
  feedback text
  graded_by uuid
  saved_at timestamp
  Note: 'إجابات كل محاولة'
}

Table quiz_attempt_events {
  id uuid [pk]
  quiz_attempt_id uuid [ref: > quiz_attempts.id]
  type varchar(20)
  meta json
  occurred_at timestamp
  Note: 'أحداث النزاهة أثناء المحاولة'
}

TableGroup "التعلّم الإلكتروني" [color: #9333EA] {
  course_materials
  section_topic_progress
  question_banks
  questions
  quizzes
  quiz_questions
  quiz_accommodations
  quiz_attempts
  quiz_answers
  quiz_attempt_events
}

// ==================== 17. العلامات ====================

Table assessment_components {
  id uuid [pk]
  course_offering_id uuid [ref: > course_offerings.id]
  name_ar varchar(100)
  name_en varchar(100)
  type varchar(20)
  weight decimal(5,2)
  max_mark decimal(6,2)
  is_final_exam boolean
  sort smallint
  Note: 'مكوّنات علامة المقرر المطروح وأوزانها'
}

Table grade_sheets {
  id uuid [pk]
  course_offering_id uuid [unique, ref: - course_offerings.id]
  status varchar(12)
  closed_at timestamp
  closed_by uuid
  reopened_at timestamp
  submitted_at timestamp
  department_reviewed_at timestamp
  verified_at timestamp
  approved_at timestamp
  published_at timestamp
  return_reason text
  Note: 'كشف علامات المقرر المطروح ومسار اعتماده'
}

Table final_grades {
  id uuid [pk]
  course_offering_id uuid [ref: > course_offerings.id]
  student_id uuid [ref: > students.user_id]
  total decimal(5,2)
  letter varchar(4)
  grade_points decimal(4,2)
  is_passed boolean
  graded_at timestamp
  Note: 'العلامة النهائية للطالب في المقرر من 100'
}

Table grade_marks {
  id uuid [pk]
  final_grade_id uuid [ref: > final_grades.id]
  assessment_component_id uuid [ref: > assessment_components.id]
  mark decimal(6,2)
  entered_by uuid
  entered_at datetime
  Note: 'علامة الطالب في كل مكوّن'
}

Table verification_marks {
  id uuid [pk]
  final_grade_id uuid [ref: > final_grades.id]
  assessment_component_id uuid [ref: > assessment_components.id]
  mark decimal(6,2)
  status varchar(10)
  resolution varchar(15)
  resolved_mark decimal(6,2)
  resolution_note text
  entered_by uuid
  entered_at timestamp
  resolved_by uuid
  resolved_at timestamp
  Note: 'الإدخال المزدوج للعلامة من شؤون الامتحانات وحل الفروقات'
}

Table grade_change_requests {
  id uuid [pk]
  final_grade_id uuid [ref: > final_grades.id]
  service_request_id uuid [ref: > service_requests.id]
  requested_by uuid
  changes json
  old_total decimal(5,2)
  new_total decimal(5,2)
  old_letter varchar(3)
  new_letter varchar(3)
  requires_dean boolean
  reason text
  attachment_file_id uuid
  status varchar(25)
  applied_by uuid
  applied_at timestamp
  Note: 'طلبات تعديل علامة منشورة واعتمادها'
}

Table grade_histories {
  id uuid [pk]
  final_grade_id uuid [ref: > final_grades.id]
  grade_change_request_id uuid
  field varchar(30)
  old_value varchar(50)
  new_value varchar(50)
  reason text
  changed_by uuid
  Note: 'سجل تغييرات العلامة'
}

Table official_transcripts {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  service_request_id uuid [ref: > service_requests.id]
  file_id uuid [ref: > files.id]
  transcript_number varchar(20) [unique]
  verification_code char(12) [unique]
  data_hash char(64)
  cumulative_gpa decimal(5,4)
  language varchar(2)
  issued_by uuid
  issued_at timestamp
  revoked_at timestamp
  Note: 'كشوف العلامات الرسمية برمز تحقق'
}

TableGroup "العلامات" [color: #DC2626] {
  assessment_components
  grade_sheets
  final_grades
  grade_marks
  verification_marks
  grade_change_requests
  grade_histories
  official_transcripts
}

// ==================== 18. الامتحانات ====================

Table exam_periods {
  id uuid [pk]
  semester_id uuid [ref: > semesters.id]
  type varchar(12)
  name_ar varchar(150)
  name_en varchar(150)
  starts_on date
  ends_on date
  suspends_classes boolean
  rules json
  status varchar(15)
  published_at timestamp
  Note: 'فترات الامتحانات وقواعدها'
}

Table exam_slots {
  id uuid [pk]
  exam_period_id uuid [ref: > exam_periods.id]
  date date
  starts_at time
  ends_at time
  label varchar(30)
  is_active boolean
  Note: 'فترات الامتحان في كل يوم'
}

Table exams {
  id uuid [pk]
  exam_period_id uuid [ref: > exam_periods.id]
  course_offering_id uuid [ref: > course_offerings.id]
  exam_slot_id uuid [ref: > exam_slots.id]
  duration_minutes smallint
  mode varchar(10)
  expected_students int
  is_locked boolean
  status varchar(15)
  notes text
  Note: 'امتحان المقرر المطروح وموعده'
}

Table exam_sections {
  exam_id uuid [ref: > exams.id]
  section_id uuid [ref: > course_sections.id]
  indexes {
    (exam_id, section_id) [pk]
  }
  Note: 'الشعب التي يجمعها الامتحان'
}

Table exam_rooms {
  id uuid [pk]
  exam_id uuid [ref: > exams.id]
  room_id uuid [ref: > rooms.id]
  seats_allocated smallint
  Note: 'قاعات الامتحان والمقاعد المخصصة فيها'
}

Table exam_seat_assignments {
  id uuid [pk]
  exam_room_id uuid [ref: > exam_rooms.id]
  enrollment_id uuid [ref: > enrollments.id]
  seat_label varchar(10)
  seat_row smallint
  seat_column smallint
  attendance varchar(10)
  attendance_marked_by uuid
  attendance_marked_at timestamp
  Note: 'مقعد كل طالب في الامتحان وحضوره'
}

Table exam_proctors {
  id uuid [pk]
  exam_slot_id uuid [ref: > exam_slots.id]
  room_id uuid [ref: > rooms.id]
  user_id uuid [ref: > users.id]
  role varchar(10)
  confirmed_at timestamp
  Note: 'المراقبون في كل قاعة وفترة'
}

Table exam_incidents {
  id uuid [pk]
  exam_id uuid [ref: > exams.id]
  student_id uuid [ref: > students.user_id]
  room_id uuid
  type varchar(20)
  description text
  action_taken text
  reported_by uuid
  reported_at timestamp
  follow_up_status varchar(15)
  Note: 'حوادث يوم الامتحان كالغش أو المرض'
}

TableGroup "الامتحانات" [color: #E11D48] {
  exam_periods
  exam_slots
  exams
  exam_sections
  exam_rooms
  exam_seat_assignments
  exam_proctors
  exam_incidents
}

// ==================== 19. تقييم المقررات ====================

Table evaluation_forms {
  id uuid [pk]
  semester_id uuid [ref: > semesters.id]
  name_ar varchar(150)
  name_en varchar(150)
  opens_at timestamp
  closes_at timestamp
  status varchar(20)
  min_responses_to_show smallint
  Note: 'استبانات تقييم المقررات في كل فصل'
}

Table evaluation_questions {
  id uuid [pk]
  evaluation_form_id uuid [ref: > evaluation_forms.id]
  category varchar(20)
  type varchar(15)
  body_ar text
  body_en text
  is_required boolean
  sort smallint
  Note: 'أسئلة الاستبانة'
}

Table evaluation_invitations {
  id uuid [pk]
  evaluation_form_id uuid [ref: > evaluation_forms.id]
  enrollment_section_id uuid [ref: > enrollment_sections.id]
  completed_at timestamp
  Note: 'دعوات الطلاب للتقييم، لتتبّع المشاركة فقط'
}

Table evaluation_responses {
  id uuid [pk]
  evaluation_form_id uuid [ref: > evaluation_forms.id]
  section_id uuid [ref: > course_sections.id]
  instructor_id uuid [ref: > instructors.id]
  submitted_on date
  Note: 'الاستجابات دون أي رابط بهوية الطالب'
}

Table evaluation_answers {
  id uuid [pk]
  evaluation_response_id uuid [ref: > evaluation_responses.id]
  evaluation_question_id uuid [ref: > evaluation_questions.id]
  value_int smallint
  value_text text
  Note: 'إجابات كل استجابة'
}

TableGroup "تقييم المقررات" [color: #A21CAF] {
  evaluation_forms
  evaluation_questions
  evaluation_invitations
  evaluation_responses
  evaluation_answers
}

// ==================== 20. القبول ====================

Table admission_cycles {
  id uuid [pk]
  intake_semester_id uuid [ref: > semesters.id]
  name_ar varchar(150)
  name_en varchar(150)
  opens_at timestamp
  closes_at timestamp
  decisions_publish_at timestamp
  application_fee decimal(10,2)
  max_preferences smallint
  status varchar(25)
  Note: 'دورات القبول ومواعيدها'
}

Table admission_programs {
  id uuid [pk]
  admission_cycle_id uuid [ref: > admission_cycles.id]
  program_id uuid [ref: > programs.id]
  capacity smallint
  waitlist_capacity smallint
  min_high_school_score decimal(5,2)
  required_tracks json
  score_formula json
  accepted_count smallint
  Note: 'البرامج المفتوحة في الدورة وسعتها وشروطها'
}

Table document_types {
  id uuid [pk]
  key varchar(40) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  is_required boolean
  applies_to json
  max_size_mb smallint
  allowed_mimes json
  Note: 'أنواع المستندات المطلوبة للتقديم'
}

Table applicants {
  id uuid [pk]
  user_id uuid [unique, ref: - users.id]
  national_id_encrypted text
  national_id_hash char(64)
  first_name_ar varchar(50)
  father_name_ar varchar(50)
  grandfather_name_ar varchar(50)
  family_name_ar varchar(50)
  full_name_en varchar(150)
  gender varchar(6)
  birth_date date
  nationality char(2)
  phone varchar(20)
  address json
  guardian json
  high_school json
  entrance_exam_score decimal(5,2)
  special_needs text
  Note: 'المتقدمون للقبول وبياناتهم'
}

Table applications {
  id uuid [pk]
  application_number varchar(20) [unique]
  admission_cycle_id uuid [ref: > admission_cycles.id]
  applicant_id uuid [ref: > applicants.id]
  student_id uuid [unique, ref: - students.user_id]
  status varchar(25)
  composite_score decimal(6,3)
  rank_in_program int
  decided_program_id uuid
  conditions text
  decision_notes text
  reviewed_by uuid
  decided_by uuid
  decided_at timestamp
  offer_sent_at timestamp
  offer_expires_at timestamp
  responded_at timestamp
  submitted_at timestamp
  Note: 'طلبات الالتحاق وقراراتها، والطالب الذي ينشأ عن قبول العرض'
}

Table application_preferences {
  id uuid [pk]
  application_id uuid [ref: > applications.id]
  admission_program_id uuid [ref: > admission_programs.id]
  priority smallint
  allocation_result varchar(15)
  Note: 'رغبات المتقدم مرتبة'
}

Table application_documents {
  id uuid [pk]
  application_id uuid [ref: > applications.id]
  document_type_id uuid [ref: > document_types.id]
  file_id uuid [ref: > files.id]
  status varchar(15)
  rejection_reason text
  verified_by uuid
  verified_at timestamp
  Note: 'مستندات الطلب ومراجعتها'
}

TableGroup "القبول" [color: #DB2777] {
  admission_cycles
  admission_programs
  document_types
  applicants
  applications
  application_preferences
  application_documents
}

// ==================== 21. المالية ====================

Table fee_types {
  id uuid [pk]
  key varchar(40) [unique]
  name_ar varchar(150)
  name_en varchar(150)
  is_refundable boolean
  gl_account_code varchar(30)
  is_active boolean
  Note: 'أنواع الرسوم'
}

Table fee_structures {
  id uuid [pk]
  academic_year_id uuid [ref: > academic_years.id]
  fee_type_id uuid [ref: > fee_types.id]
  program_id uuid [ref: > programs.id]
  student_category varchar(20)
  calculation varchar(20)
  amount decimal(10,2)
  currency char(3)
  effective_from date
  Note: 'قيمة كل رسم لكل برنامج وسنة أكاديمية'
}

Table invoices {
  id uuid [pk]
  invoice_number varchar(20) [unique]
  student_id uuid [ref: > students.user_id]
  applicant_id uuid [ref: > applicants.id]
  semester_id uuid [ref: > semesters.id]
  issue_date date
  due_date date
  subtotal decimal(12,2)
  discount_total decimal(12,2)
  total decimal(12,2)
  paid_total decimal(12,2)
  balance decimal(12,2)
  currency char(3)
  status varchar(20)
  source_type varchar(30)
  source_id uuid
  notes text
  Note: 'فواتير الطلاب والمتقدمين للقبول'
}

Table invoice_items {
  id uuid [pk]
  invoice_id uuid [ref: > invoices.id]
  fee_type_id uuid [ref: > fee_types.id]
  scholarship_award_id uuid [ref: > scholarship_awards.id]
  description_ar varchar(255)
  description_en varchar(255)
  quantity decimal(8,2)
  unit_price decimal(10,2)
  discount_amount decimal(10,2)
  amount decimal(12,2)
  related_type varchar(30)
  related_id uuid
  Note: 'بنود الفاتورة'
}

Table payments {
  id uuid [pk]
  payment_number varchar(20) [unique]
  receipt_number varchar(20)
  student_id uuid [ref: > students.user_id]
  payer_type varchar(20)
  payer_id uuid
  amount decimal(12,2)
  currency char(3)
  method varchar(20)
  gateway varchar(30)
  gateway_reference varchar(120)
  status varchar(20)
  idempotency_key uuid [unique]
  paid_at timestamp
  received_by uuid
  reversal_reason text
  notes text
  Note: 'الدفعات الإلكترونية والنقدية'
}

Table payment_allocations {
  id uuid [pk]
  payment_id uuid [ref: > payments.id]
  invoice_id uuid [ref: > invoices.id]
  amount decimal(12,2)
  Note: 'توزيع كل دفعة على الفواتير'
}

Table gateway_transactions {
  id uuid [pk]
  payment_id uuid [ref: > payments.id]
  gateway varchar(30)
  event varchar(40)
  reference varchar(120)
  request_payload json
  response_payload json
  signature_verified boolean
  http_status smallint
  Note: 'سجل التخاطب مع بوابة الدفع'
}

Table student_ledger_entries {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  type varchar(20)
  amount decimal(12,2)
  balance_after decimal(12,2)
  reference_type varchar(30)
  reference_id uuid
  description_ar varchar(255)
  Note: 'دفتر حساب الطالب، قيوده لا تُعدَّل'
}

Table installment_plans {
  id uuid [pk]
  invoice_id uuid [ref: > invoices.id]
  service_request_id uuid [ref: > service_requests.id]
  total_amount decimal(12,2)
  down_payment decimal(12,2)
  installments_count smallint
  status varchar(15)
  approved_by uuid
  Note: 'خطط تقسيط الفواتير'
}

Table installments {
  id uuid [pk]
  installment_plan_id uuid [ref: > installment_plans.id]
  sequence smallint
  due_date date
  amount decimal(12,2)
  paid_amount decimal(12,2)
  status varchar(15)
  Note: 'أقساط كل خطة'
}

Table scholarships {
  id uuid [pk]
  name_ar varchar(150)
  name_en varchar(150)
  type varchar(25)
  coverage_type varchar(15)
  value decimal(10,2)
  applies_to_fee_types json
  min_gpa_to_maintain decimal(3,2)
  min_hours_to_maintain smallint
  max_semesters smallint
  sponsor_name varchar(150)
  budget decimal(14,2)
  is_active boolean
  Note: 'المنح وشروط استمرارها'
}

Table scholarship_awards {
  id uuid [pk]
  scholarship_id uuid [ref: > scholarships.id]
  student_id uuid [ref: > students.user_id]
  from_semester_id uuid
  to_semester_id uuid
  status varchar(15)
  suspension_reason text
  semesters_used smallint
  approved_by uuid
  Note: 'منح الطلاب ومدتها'
}

Table fines {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  invoice_item_id uuid [ref: > invoice_items.id]
  type varchar(25)
  amount decimal(10,2)
  reason_ar varchar(255)
  source_type varchar(30)
  source_id uuid
  status varchar(15)
  waived_by uuid
  waiver_reason text
  issued_by uuid
  Note: 'الغرامات، ومنها غرامات تأخير الكتب'
}

Table refunds {
  id uuid [pk]
  payment_id uuid [ref: > payments.id]
  invoice_id uuid [ref: > invoices.id]
  amount decimal(12,2)
  reason varchar(30)
  method varchar(20)
  status varchar(15)
  requested_by uuid
  approved_by uuid
  processed_at timestamp
  bank_details_encrypted text
  notes text
  Note: 'المبالغ المستردة للطلاب'
}

TableGroup "المالية" [color: #047857] {
  fee_types
  fee_structures
  invoices
  invoice_items
  payments
  payment_allocations
  gateway_transactions
  student_ledger_entries
  installment_plans
  installments
  scholarships
  scholarship_awards
  fines
  refunds
}

// ==================== 22. الطلبات الإلكترونية ====================

Table request_types {
  id uuid [pk]
  key varchar(40) [unique]
  module varchar(30)
  name_ar varchar(150)
  name_en varchar(150)
  description_ar text
  fee_type_id uuid [ref: > fee_types.id]
  requester_roles json
  form_schema json
  workflow json
  required_documents json
  fee_amount decimal(10,2)
  sla_days smallint
  window_type varchar(30)
  handler_key varchar(60)
  is_active boolean
  Note: 'أنواع الطلبات الإلكترونية ونماذجها وخطوات اعتمادها'
}

Table service_requests {
  id uuid [pk]
  request_number varchar(20) [unique]
  request_type_id uuid [ref: > request_types.id]
  requester_id uuid [ref: > users.id]
  invoice_id uuid [ref: > invoices.id]
  semester_id uuid
  payload json
  status varchar(20)
  current_step smallint
  current_role varchar(50)
  current_assignee_id uuid
  outcome json
  submitted_at timestamp
  due_at timestamp
  completed_at timestamp
  Note: 'الطلبات الإلكترونية المقدمة'
}

Table request_steps {
  id uuid [pk]
  service_request_id uuid [ref: > service_requests.id]
  step_no smallint
  role varchar(50)
  assignee_id uuid
  decision varchar(15)
  comment text
  decided_at timestamp
  Note: 'خطوات اعتماد الطلب وقراراتها'
}

Table request_comments {
  id uuid [pk]
  service_request_id uuid [ref: > service_requests.id]
  author_id uuid
  body text
  is_internal boolean
  attachment_file_id uuid
  Note: 'المراسلات على الطلب'
}

TableGroup "الطلبات الإلكترونية" [color: #0E7490] {
  request_types
  service_requests
  request_steps
  request_comments
}

// ==================== 23. شؤون الموظفين ====================

Table employees {
  id uuid [pk]
  user_id uuid [unique, ref: - users.id]
  position_id uuid [ref: > positions.id]
  manager_employee_id uuid [ref: > employees.id]
  national_id_encrypted text
  national_id_hash char(64)
  employment_type varchar(20)
  hire_date date
  gender varchar(6)
  birth_date date
  nationality char(2)
  marital_status varchar(15)
  address json
  emergency_contact json
  bank_account_encrypted text
  status varchar(15)
  termination_date date
  termination_reason text
  Note: 'الملف الوظيفي للموظف ومديره المباشر'
}

Table positions {
  id uuid [pk]
  code varchar(20) [unique]
  title_ar varchar(150)
  title_en varchar(150)
  category varchar(20)
  grade varchar(20)
  is_active boolean
  Note: 'المسميات الوظيفية'
}

Table contracts {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  file_id uuid [ref: > files.id]
  contract_number varchar(30) [unique]
  type varchar(20)
  start_date date
  end_date date
  probation_end_date date
  salary_encrypted text
  currency char(3)
  weekly_hours smallint
  status varchar(15)
  renewal_of_id uuid
  notes text
  Note: 'عقود الموظفين'
}

Table leave_types {
  id uuid [pk]
  key varchar(30) [unique]
  name_ar varchar(100)
  name_en varchar(100)
  default_days_per_year smallint
  is_paid boolean
  requires_attachment boolean
  max_consecutive_days smallint
  min_notice_days smallint
  carry_over_max smallint
  affects_teaching boolean
  is_active boolean
  Note: 'أنواع الإجازات وقواعدها'
}

Table leave_balances {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  leave_type_id uuid [ref: > leave_types.id]
  year smallint
  entitled_days decimal(5,1)
  carried_over_days decimal(5,1)
  used_days decimal(5,1)
  pending_days decimal(5,1)
  adjustment_days decimal(5,1)
  Note: 'رصيد كل موظف من كل نوع إجازة في السنة'
}

Table leave_requests {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  instructor_id uuid
  leave_type_id uuid [ref: > leave_types.id]
  starts_on date
  ends_on date
  reason text
  suggested_substitute_id uuid
  status varchar(20)
  manager_id uuid
  manager_decided_at timestamp
  manager_comment text
  cancelled_at timestamp
  cancelled_by uuid
  affects_sessions_count smallint
  days_count decimal(5,1)
  hr_decided_at timestamp
  rejection_reason text
  Note: 'طلبات الإجازة واعتمادها'
}

Table staff_attendance {
  id uuid [pk]
  employee_id uuid [ref: > employees.id]
  date date
  check_in_at timestamp
  check_out_at timestamp
  status varchar(15)
  late_minutes smallint
  early_leave_minutes smallint
  source varchar(15)
  leave_request_id uuid
  notes varchar(255)
  Note: 'دوام الموظفين من أجهزة البصمة'
}

Table performance_cycles {
  id uuid [pk]
  year smallint
  name_ar varchar(150)
  name_en varchar(150)
  starts_on date
  ends_on date
  status varchar(15)
  criteria_template json
  Note: 'دورات تقييم الأداء'
}

Table performance_reviews {
  id uuid [pk]
  performance_cycle_id uuid [ref: > performance_cycles.id]
  employee_id uuid [ref: > employees.id]
  reviewer_id uuid
  status varchar(20)
  self_score decimal(5,2)
  manager_score decimal(5,2)
  final_score decimal(5,2)
  rating varchar(25)
  evaluation_score decimal(5,2)
  strengths text
  improvements text
  goals json
  employee_comments text
  acknowledged_at timestamp
  Note: 'تقييم أداء كل موظف في الدورة'
}

TableGroup "شؤون الموظفين" [color: #C2410C] {
  employees
  positions
  contracts
  leave_types
  leave_balances
  leave_requests
  staff_attendance
  performance_cycles
  performance_reviews
}

// ==================== 24. المكتبة ====================

Table library_items {
  id uuid [pk]
  type varchar(20)
  isbn varchar(20)
  issn varchar(20)
  title varchar(500)
  subtitle varchar(500)
  authors varchar(500)
  publisher varchar(200)
  publication_year smallint
  edition varchar(50)
  language varchar(5)
  call_number varchar(50)
  subjects json
  description text
  cover_file_id uuid
  is_digital boolean
  digital_file_id uuid [ref: > files.id]
  access_level varchar(20)
  is_loanable boolean
  replacement_cost decimal(10,2)
  Note: 'كتالوج المكتبة ومؤلفو كل مادة'
}

Table library_copies {
  id uuid [pk]
  library_item_id uuid [ref: > library_items.id]
  barcode varchar(30) [unique]
  location varchar(100)
  status varchar(20)
  condition varchar(15)
  acquired_on date
  price decimal(10,2)
  Note: 'النسخ الورقية وأماكنها'
}

Table borrowing_policies {
  id uuid [pk]
  role_id uuid [ref: > roles.id]
  item_type varchar(20)
  max_items smallint
  loan_days smallint
  max_renewals smallint
  grace_days smallint
  fine_per_day decimal(8,2)
  max_fine_ratio decimal(4,2)
  Note: 'سياسة الإعارة لكل دور ونوع مادة'
}

Table loans {
  id uuid [pk]
  library_copy_id uuid [ref: > library_copies.id]
  borrower_user_id uuid [ref: > users.id]
  fine_id uuid [ref: > fines.id]
  borrowed_at timestamp
  due_at timestamp
  returned_at timestamp
  renewals_count smallint
  status varchar(15)
  issued_by uuid
  returned_to uuid
  return_condition varchar(15)
  Note: 'إعارة النسخ وإرجاعها'
}

Table library_holds {
  id uuid [pk]
  library_item_id uuid [ref: > library_items.id]
  user_id uuid [ref: > users.id]
  library_copy_id uuid
  status varchar(15)
  requested_at timestamp
  ready_at timestamp
  pickup_expires_at timestamp
  Note: 'حجوزات النسخ المعارة'
}

TableGroup "المكتبة" [color: #92400E] {
  library_items
  library_copies
  borrowing_policies
  loans
  library_holds
}

// ==================== 25. الذكاء الاصطناعي ====================

Table ai_providers {
  id uuid [pk]
  provider varchar(20) [unique]
  key_encrypted text
  key_hint varchar(12)
  model varchar(120)
  base_url varchar(255)
  price_input decimal(10,4)
  price_output decimal(10,4)
  last_tested_at timestamp
  last_test_ok boolean
  last_test_ms int
  last_test_code varchar(60)
  Note: 'مزوّدو النماذج اللغوية ومفاتيحهم'
}

Table ai_feature_access {
  id uuid [pk]
  feature varchar(40)
  role_code varchar(40)
  enabled boolean
  daily_limit int
  Note: 'تفعيل كل ميزة ذكاء لكل دور وحصتها اليومية'
}

Table ai_conversations {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  role_code varchar(40)
  title varchar(160)
  messages_count int
  last_message_at timestamp
  Note: 'محادثات المساعد الذكي'
}

Table ai_messages {
  id uuid [pk]
  conversation_id uuid [ref: > ai_conversations.id]
  role varchar(12)
  content text
  tools json
  cards json
  status varchar(16)
  error_code varchar(60)
  input_tokens int
  output_tokens int
  feedback tinyint
  feedback_note varchar(500)
  feedback_at timestamp
  Note: 'رسائل كل محادثة'
}

Table ai_usage_logs {
  id uuid [pk]
  user_id uuid
  role_code varchar(40)
  feature varchar(40)
  provider varchar(20)
  model varchar(120)
  status varchar(16)
  error_code varchar(60)
  input_tokens int
  output_tokens int
  cost_usd decimal(12,6)
  latency_ms int
  tool_calls smallint
  conversation_id uuid
  Note: 'سجل استخدام الذكاء وكلفته'
}

Table knowledge_documents {
  id uuid [pk]
  code varchar(60) [unique]
  title_ar varchar(200)
  title_en varchar(200)
  category varchar(30)
  summary_ar text
  summary_en text
  Note: 'لوائح الجامعة'
}

Table knowledge_document_versions {
  id uuid [pk]
  knowledge_document_id uuid [ref: > knowledge_documents.id]
  version_label varchar(30)
  effective_from date
  status varchar(12)
  stored_file_id uuid [ref: > files.id]
  file_name varchar(200)
  change_note text
  pages smallint
  characters int
  articles_count smallint
  chunks_count smallint
  embedder varchar(200)
  last_error varchar(60)
  uploaded_by uuid
  indexed_at timestamp
  embedded_at timestamp
  retired_at timestamp
  retired_by uuid
  Note: 'إصدارات كل لائحة وتاريخ نفاذها'
}

Table knowledge_chunks {
  id uuid [pk]
  knowledge_document_version_id uuid [ref: > knowledge_document_versions.id]
  position smallint
  article varchar(40)
  article_title varchar(300)
  heading varchar(300)
  part tinyint
  text text
  embedding text
  Note: 'مقاطع اللوائح وتضميناتها للبحث'
}

Table prediction_models {
  id uuid [pk]
  kind varchar(20)
  version varchar(20)
  algorithm varchar(40)
  features json
  metrics json
  baseline_metrics json
  trained_from_semester_id uuid
  trained_to_semester_id uuid
  status varchar(15)
  trained_at timestamp
  activated_at timestamp
  activated_by uuid
  Note: 'نماذج التنبؤ بالطلب وبخطر التعثر وإصداراتها ودقتها'
}

Table student_risk_scores {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  semester_id uuid [ref: > semesters.id]
  prediction_model_id uuid [ref: > prediction_models.id]
  score decimal(5,4)
  level varchar(10)
  factors json
  computed_at timestamp
  Note: 'مؤشر خطر التعثر لكل طالب وأبرز أسبابه'
}

Table simulations {
  id uuid [pk]
  base_semester_id uuid [ref: > semesters.id]
  schedule_generation_job_id uuid [ref: > schedule_generation_jobs.id]
  name varchar(150)
  parameters json
  status varchar(15)
  results json
  Note: 'محاكاة الاحتمالات المستقبلية على نسخة معزولة من بيانات الفصل'
}

TableGroup "الذكاء الاصطناعي" [color: #6D28D9] {
  ai_providers
  ai_feature_access
  ai_conversations
  ai_messages
  ai_usage_logs
  knowledge_documents
  knowledge_document_versions
  knowledge_chunks
  prediction_models
  student_risk_scores
  simulations
}
