  body_encrypted text
  visibility varchar(20)
  category varchar(20)
  Note: 'ملاحظات الإرشاد السرية'
}

Table academic_warnings {
  id uuid [pk]
  student_id uuid [ref: > students.user_id]
  semester_id uuid [ref: > semesters.id]
  type varchar(30)
  severity varchar(10)
  details json
  status varchar(15)
  acknowledged_by_student_at timestamp
  advisor_action_notes text
  resolved_at timestamp
  Note: 'الإنذارات الأكاديمية ومتابعتها'
}

TableGroup "الإرشاد الأكاديمي" [color: #65A30D] {
  advising_clearances
  advising_appointments
  advising_notes
